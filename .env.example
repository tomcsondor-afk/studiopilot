# Copy to .env (or set in your host's environment). Never commit real secrets.
APP_NAME=StudioPilot
PORT=3000
DATABASE_PATH=./data/studiopilot.db

# Required for brand analysis, generation, refining and briefs. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Set to true behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Set to false and run `npm run worker` separately in production.
RUN_WORKER_IN_PROCESS=true

# Crawler limits
CRAWL_MAX_PAGES=12
CRAWL_MAX_DEPTH=2
CRAWL_MAX_BYTES=2000000
CRAWL_DELAY_MS=800
